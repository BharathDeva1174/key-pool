# KeyPool environment overrides.
# Every value here is optional — Settings in the dashboard take precedence,
# and these are just first-run defaults for headless / scripted starts.
# Copy this file to `.env` and edit as needed. The server does NOT read .env
# automatically; run.bat does not either. These are read by `src/env.ts`.

# Port for the single process serving both the dashboard and /v1.
PORT=20121

# Interface to bind. 127.0.0.1 keeps the proxy local-only (recommended).
KEYPOOL_HOST=127.0.0.1

# Where data.sqlite and master.key live.
KEYPOOL_DATA_DIR=./data

# Log level for the server process: fatal | error | warn | info | debug | trace | silent
KEYPOOL_LOG_LEVEL=info

# Note: whether the unified API key is required is a dashboard *setting*
# (`requireApiKey` in the settings table), not an environment variable. An
# earlier version of this file documented KEYPOOL_REQUIRE_API_KEY, but nothing
# in server/src ever read it — toggle it on the Settings page instead.
